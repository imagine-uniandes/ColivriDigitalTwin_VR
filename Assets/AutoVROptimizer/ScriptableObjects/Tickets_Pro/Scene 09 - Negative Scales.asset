  m_Script: {fileID: 11500000, guid: 40f851f310b170d46a2387d5cc9d7008, type: 3}
  m_Name: Scene 09 - Negative Scales
  m_EditorClassIdentifier: 
  data:
    name: Some Objects have Negative Scales
    description: "<b>\u2022 What It Does:</b> Applying a negative scale (e.g., -1)
      to objects can break lighting calculations and frustrate GPU-based culling
      systems. It can also interfere with physics colliders.\n\n<b>\u2022 Our Modification:
      </b>Always avoid negative scales. Instead, flip models in 3D modeling software
      or adjust orientation using rotation. This ensures stable rendering, correct
      lighting, and physics behavior."
    state: 0
    level: 1
    tags: 16448
    functionName: NegativeScales
    noFix: 0
    noRestore: 0
    hide: 0
