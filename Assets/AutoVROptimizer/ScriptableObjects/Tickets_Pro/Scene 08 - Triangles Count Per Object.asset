  m_Name: Scene 08 - Triangles Count Per Object
  m_EditorClassIdentifier: 
  data:
    name: Some of your Objects have a Higher Triangles Count\nthan set in AVRO_Settings
    description: "<b>\u2022 What It Does:</b> Prevents large triangle meshes that
      can't be culled efficiently.\n\n<b>\u2022 Our Modification: </b>Keeping objects
      under ~10k triangles helps batching and reduces overdraw."
    state: 0
    level: 1
    tags: 64
    functionName: TrianglesCountPerObject
    noFix: 1
    noRestore: 0
    hide: 0
